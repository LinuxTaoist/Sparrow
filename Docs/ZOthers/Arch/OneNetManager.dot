#@startdot

digraph OneNetManager {
    rankdir=LR;
    nodesep=1.2;  // 节点水平间距 0.5 -> 1.2
    ranksep=1.0;  // 层级垂直间距 1.0

    node [shape=ellipse, fontsize=11, height=0.6];
    edge [fontsize=9, color="#666666"];

    // 状态节点
    {rank = same; LEV1_ONENET_MGR_IDLE LEV1_ONENET_MGR_CONNECTING};
    {rank = same; LEV1_ONENET_MGR_CONNECTED LEV1_ONENET_MGR_DISCONNECTED};

    // 状态转换
    LEV1_ONENET_MGR_IDLE -> LEV1_ONENET_MGR_CONNECTING [label="1. SIG_ID_ONENET_MGR_ACTIVE_DEVICE_CONNECT \n 2. SIG_ID_ONENET_MGR_REACTIVE_CUR_DEVICE_CONNECT", style=dashed];
    LEV1_ONENET_MGR_CONNECTING -> LEV1_ONENET_MGR_CONNECTED [label="SIG_ID_ONENET_DRV_MQTT_MSG_CONNACK (Connect)", style=dashed];
    LEV1_ONENET_MGR_CONNECTING -> LEV1_ONENET_MGR_DISCONNECTED [label="SIG_ID_ONENET_DRV_MQTT_MSG_CONNACK (Disconnect)", style=dashed];
    LEV1_ONENET_MGR_CONNECTED -> LEV1_ONENET_MGR_DISCONNECTED [label="SIG_ID_ONENET_MGR_DEACTIVE_DEVICE", style=dashed];
    LEV1_ONENET_MGR_CONNECTED -> LEV1_ONENET_MGR_CONNECTING [label="SIG_ID_ONENET_MGR_DEIVCE_DISCONNECT_PASSIVE", style=dashed];
    LEV1_ONENET_MGR_DISCONNECTED -> LEV1_ONENET_MGR_CONNECTING [label="1. SIG_ID_ONENET_MGR_ACTIVE_DEVICE_CONNECT \n 2. SIG_ID_ONENET_MGR_REACTIVE_CUR_DEVICE_CONNECT", style=dashed];
}

#@enddot
