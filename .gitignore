.repo/
.vscode/
Release/
Components/Business/

3rdParty/curl/*
!/3rdParty/curl/include
!/3rdParty/curl/build.sh
!/3rdParty/curl/curl-8.10.1.tar.gz

3rdParty/googletest/*
!/3rdParty/googletest/include
!/3rdParty/googletest/build.sh
!/3rdParty/googletest/googletest-1.12.1.tar.gz

3rdParty/sqlite/*
!/3rdParty/sqlite/include
!/3rdParty/sqlite/build.sh
!/3rdParty/sqlite/sqlite-amalgamation-3450300.tar.gz

Platform/*
!/Platform/Default

Hardware/*
!/Hardware/CMakeLists.txt
!/Hardware/Default
!/Hardware/Common

Tools/gtestreport/*
!/Tools/gtestreport/gtest_coverage.sh
!/Tools/gtestreport/gtest_report.sh
!/Tools/gtestreport/README.md

Tools/valgrind/*
!/Tools/valgrind/start_valgrind.sh
!/Tools/valgrind/stop_valgrind.sh
!/Tools/valgrind/README.md
